# ─────────────────────────────────────────────────────────────
# InterviewIQ — copy to `.env.local` and fill in.
# Everything here stays on the server. Friends you invite never
# see or need any of these keys.
# ─────────────────────────────────────────────────────────────

# ── AI providers ─────────────────────────────────────────────
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=

# Interviewer voices (any voice_id from your ElevenLabs library).
ELEVENLABS_VOICE_ID_MALE=pNInz6obpgDQGcFmaJgB
ELEVENLABS_VOICE_ID_FEMALE=EXAVITQu4vr4xnSDxMaL
# Second voices, used by the second interviewer on a panel.
# ELEVENLABS_VOICE_ID_MALE_2=ErXwobaYiN019PkySvjV
# ELEVENLABS_VOICE_ID_FEMALE_2=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL=eleven_flash_v2_5

# Optional model overrides (defaults shown).
# MODEL_INTERVIEWER=claude-sonnet-5-5
# MODEL_COACH=claude-opus-5-5
# MODEL_FAST=claude-haiku-5-5
# MODEL_RESEARCH=claude-sonnet-5-5

# ── Access ───────────────────────────────────────────────────
# Signs invite links. Generate with:
#   node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
# Changing it invalidates every link you've shared.
APP_SECRET=
# Passcode for the admin console at /admin.
ADMIN_PASSCODE=
# Shown to friends: "<OWNER_NAME> invited you".
OWNER_NAME=

# ── Server ───────────────────────────────────────────────────
PORT=3000
# Where the invite registry lives (default ~/.interviewiq). Use a persistent
# volume path when deploying.
# DATA_DIR=/data

# Fine-tune when the interviewer decides you've finished talking (ms).
# TURN_SETTLE_MS=3500

# Cost estimates for the admin dashboard (USD).
# PRICE_TTS_PER_1K_CHARS=0.15
# PRICE_STT_PER_MIN=0.0077
